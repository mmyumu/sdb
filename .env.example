# Configuration locale du projet.
#
# Copier ce fichier en `.env` et l'adapter. `.env` n'est pas versionné : il porte
# les adresses de ta machine, de ton réseau et de ton Raspberry, qui ne regardent
# personne d'autre.
#
#   cp .env.example .env

# Port du serveur de développement.
SDB_PORT=5173

# Hôte SSH vers lequel ouvrir le tunnel inverse (`npm run pi`).
# Un alias de ~/.ssh/config, ou user@adresse.
SDB_SSH_HOST=raspberry

# Adresses à inscrire dans le certificat de développement (`npm run cert`),
# séparées par des virgules. La première est celle affichée pour le casque.
# Sous WSL, l'adresse de Windows est détectée et ajoutée automatiquement.
# Exemple : l'adresse du Raspberry qui porte le tunnel.
SDB_HOST_IP=192.168.1.2

# Noms de domaine autorisés à servir l'app, en plus des tunnels connus.
# À renseigner le jour où l'app tourne derrière un nom à toi.
SDB_ALLOWED_HOSTS=
